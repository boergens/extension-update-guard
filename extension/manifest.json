{
  "manifest_version": 3,
  "name": "Update Guard",
  "version": "1.0.0",
  "description": "Turns extensions off when they update and asks you to review the new version before it runs again.",
  "minimum_chrome_version": "116",
  "permissions": ["management", "storage", "notifications"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Update Guard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "review.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
